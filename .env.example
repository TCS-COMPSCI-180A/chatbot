# =============================================================================
# APPLICATION
# =============================================================================
ENVIRONMENT=development
SECRET_KEY=change-me-in-production

# =============================================================================
# DATABASE (docker-compose will run PostgreSQL on port 5433)
# =============================================================================
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=chatbot_db
POSTGRES_PORT=5433

# Local development: connects to localhost:5433
# Docker Compose services: connect to postgres:5432 (internal)
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/chatbot_db

# =============================================================================
# AI API KEYS
# =============================================================================
# Get your free API key from: https://aistudio.google.com/apikey
# This key is used for:
# - LLM generation (gemini-2.5-flash)
# - Document embeddings (gemini-embedding-001)
# - Strategy selection and critic validation
GOOGLE_API_KEY=your-google-api-key-here

# =============================================================================
# BACKEND
# =============================================================================
BACKEND_PORT=8000
CORS_ORIGINS=http://localhost:3000

# =============================================================================
# FRONTEND
# =============================================================================
FRONTEND_PORT=3000
REACT_APP_API_URL=http://localhost:8000
