# Environment Configuration Template
# Copy this file to .env and fill in your actual values
# DO NOT commit .env to version control

# =============================================================================
# APPLICATION SETTINGS
# =============================================================================
ENVIRONMENT=development
SECRET_KEY=your-secret-key-here-change-in-production-use-long-random-string

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=chatbot_db
POSTGRES_PORT=5432

# Database URL (constructed from above values)
# Format: postgresql://user:password@host:port/database
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/chatbot_db

# =============================================================================
# AI/ML API KEYS
# =============================================================================
# OpenAI API Key (for GPT models)
OPENAI_API_KEY=sk-your-openai-api-key-here

# Anthropic API Key (for Claude models)
ANTHROPIC_API_KEY=sk-ant-your-anthropic-api-key-here

# =============================================================================
# BACKEND SERVICE
# =============================================================================
BACKEND_PORT=8000
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# JWT Settings
JWT_SECRET_KEY=your-jwt-secret-key-here
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# =============================================================================
# FRONTEND SERVICE
# =============================================================================
FRONTEND_PORT=3000
REACT_APP_API_URL=http://localhost:8000
REACT_APP_ENV=development

# =============================================================================
# OPTIONAL: ADDITIONAL SERVICES
# =============================================================================
# Redis (if you add caching)
# REDIS_HOST=redis
# REDIS_PORT=6379
# REDIS_PASSWORD=

# Logging
LOG_LEVEL=INFO

# =============================================================================
# DEVELOPMENT SETTINGS
# =============================================================================
# Enable hot-reload for frontend in Docker
CHOKIDAR_USEPOLLING=true
WATCHPACK_POLLING=true
